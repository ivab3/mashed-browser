{
  "name": "mashed-browser",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@9.12.2",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "extract": "node --import tsx tools/extractor/src/cli.ts extract",
    "assets:inspect": "node --import tsx tools/extractor/src/cli.ts inspect",
    "assets:probe": "node --import tsx packages/assets/src/probe.ts",
    "asset-viewer": "pnpm --filter @mashed/asset-viewer dev",
    "ai:lap": "pnpm --filter @mashed/physics ai:lap",
    "ai:tracks": "pnpm --filter @mashed/physics ai:tracks",
    "track-events:validate": "node --import tsx apps/web/src/track-events-cli.ts",
    "alpha:replay": "node --import tsx packages/replay/src/alpha-series-cli.ts",
    "lap:validate": "pnpm --filter @mashed/physics lap:validate",
    "m1:soak": "node --expose-gc --import tsx packages/replay/src/soak-cli.ts",
    "match:replay": "node --import tsx packages/replay/src/match-replay-cli.ts",
    "web": "pnpm --filter @mashed/web dev",
    "vehicle:tune": "pnpm --filter @mashed/physics tune",
    "build": "pnpm -r --if-present build",
    "content:validate": "pnpm --filter @mashed/physics content:validate",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  }
}
